# Copy to .env and fill in. Never commit .env.
# All configuration is read through src/jazzdisco/config.py — no adapter reads
# os.environ directly.

# ---------- Database ----------
DATABASE_URL=postgresql://jazzdisco:CHANGEME@localhost:5432/jazzdisco
POSTGRES_USER=jazzdisco
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=jazzdisco

# ---------- Spotify ----------
# https://developer.spotify.com/dashboard — create an app, add the redirect URI below.
# Scopes required:
#   playlist-modify-private playlist-modify-public playlist-read-private
#   user-read-currently-playing user-read-recently-played
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Obtained once via scripts/spotify_auth.py, then reused forever.
SPOTIFY_REFRESH_TOKEN=

# ---------- Anthropic (extraction + adjudication) ----------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5
ADJUDICATION_MODEL=claude-haiku-4-5

# ---------- MusicBrainz ----------
# MB requires a descriptive User-Agent with contact info, or it will rate-limit hard.
MUSICBRAINZ_USER_AGENT=nyc-jazz-discovery/1.0 ( you@example.com )
MUSICBRAINZ_TIMEOUT_SECONDS=2
MUSICBRAINZ_MISS_TTL_DAYS=30

# ---------- Pipeline ----------
RUN_HOUR_ET=13
HORIZON_WEEKS_AHEAD=4
RETAIN_WEEKS_PAST=1
TRACKS_MATCH_ACCEPT=0.80
TRACKS_MATCH_REVIEW=0.50
DRY_RUN=0

# ---------- MCP server ----------
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PUBLIC_URL=https://mcp.example.com
# Google OAuth client used by FastMCP's OAuthProxy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these emails may connect. Comma-separated; keep it to one.
MCP_ALLOWED_EMAILS=you@example.com

# ---------- Alerting ----------
# Pick an unguessable topic; anyone who knows it can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
CHRONIC_FAILURE_THRESHOLD=3
